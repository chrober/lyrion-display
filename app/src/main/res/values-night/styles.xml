<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Uses the device's UI night-mode configuration, where supported. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- Up to Android 11, show the real themed loading view instead of a
             theme-agnostic Android starting-window flash. Android 12+ defines
             its own styles and keeps the mandatory system splash screen. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/startup_window_background</item>
    </style>
</resources>
